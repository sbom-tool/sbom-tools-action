#!/usr/bin/env bash
# Stand-in for curl, used by tests/run-tests.sh: "downloads" a release asset
# by copying the file of the same name (the URL's last path segment) from
# $STUB_RELEASE_DIR, and logs each URL to $STUB_CURL_LOG. A missing file is a
# 404, as curl -f reports it.

out='' url=''
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    --proto | --retry | --max-time | -H) shift 2 ;;
    -*) shift ;;
    *) url="$1"; shift ;;
  esac
done
if [ -n "${STUB_CURL_LOG:-}" ]; then printf '%s\n' "$url" >>"$STUB_CURL_LOG"; fi
src="${STUB_RELEASE_DIR:-/nonexistent}/${url##*/}"
if [ -z "$url" ] || [ ! -f "$src" ]; then
  echo 'curl: (22) The requested URL returned error: 404' >&2
  exit 22
fi
if [ -n "$out" ]; then cp "$src" "$out"; else cat "$src"; fi
